[resource]
script = ExtResource("biome_script")
id = &"conifer_highland"
massif_range = Vector2(0.5, 1)
massif_falloff = 0.15
edge_noise = SubResource("FastNoiseLite_edge")
strata = Array[ExtResource("stratum_script")]([SubResource("BiomeStratum_canopy"), SubResource("BiomeStratum_understory"), SubResource("BiomeStratum_shrub"), SubResource("BiomeStratum_ground")])
